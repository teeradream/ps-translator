<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainStreamLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".stream.StreamActivity"
    android:keepScreenOn="true"
    android:background="#000000">

    <!-- Game Video Stream -->
    <com.metallic.chiaki.stream.AspectRatioFrameLayout
        android:id="@+id/aspectRatioLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">
        <SurfaceView
            android:id="@+id/surfaceView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.metallic.chiaki.stream.AspectRatioFrameLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"/>

    <!-- Subtitle Translation Overlay (floating over video stream) -->
    <LinearLayout
        android:id="@+id/subtitleOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#D9060810"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="false">

        <TextView
            android:id="@+id/originalSubText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:text=""
            android:visibility="gone"/>

        <TextView
            android:id="@+id/translatedSubText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:shadowColor="#FF000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:gravity="center"
            android:text=""/>
    </LinearLayout>

    <!-- Pure Text Only Mode: ONLY text on pure black background without video -->
    <FrameLayout
        android:id="@+id/pureFullscreenLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp">

            <TextView
                android:id="@+id/pureOriginalText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#77FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginBottom="12dp"
                android:text=""
                android:visibility="gone"/>

            <TextView
                android:id="@+id/pureFullscreenText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center"
                android:text="PS Translator\n(รอรับข้อความซับไตเติ้ลจากเกม...)"/>

            <TextView
                android:id="@+id/pureFullscreenHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#55FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="24dp"
                android:text="(แตะที่หน้าจอเพื่อสลับกลับสู่โหมดภาพเกม)"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Subtitle Crop Box Editor Overlay -->
    <FrameLayout
        android:id="@+id/cropEditorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#4D000000"
        android:elevation="12dp">

        <!-- Top Bar for Crop Editor -->
        <LinearLayout
            android:id="@+id/cropTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:background="#E610141E"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ลากกรอบสีเขียวไปวางตรงพื้นที่ซับไตเติ้ลเกม"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetCropBox"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="รีเซ็ตค่าเริ่มต้น"
                android:textColor="#64B5F6"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveCropBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="บันทึกกรอบ"
                android:textColor="#FFFFFF"
                app:backgroundTint="#2E7D32"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Floating Adjustable Crop Box Frame -->
        <FrameLayout
            android:id="@+id/cropBoxFrame"
            android:layout_width="320dp"
            android:layout_height="100dp"
            android:background="@drawable/bg_crop_box"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/cropBoxGuideText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="กรอบอ่านซับ (ลากเพื่อย้าย)"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <!-- Corner Resize Handle (bottom right) -->
            <ImageView
                android:id="@+id/cropResizeHandle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_resize_handle"
                android:contentDescription="ปรับขนาดกรอบ"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"/>
        </FrameLayout>
    </FrameLayout>

    <!-- Floating Circular Button with 3 lines (Hamburger Menu) -->
    <ImageButton
        android:id="@+id/btnMenuToggle"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_circle_button"
        android:src="@drawable/ic_menu_3lines"
        android:contentDescription="ตั้งค่าการแปลภาษา"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Settings Menu Modal Backdrop & Panel -->
    <FrameLayout
        android:id="@+id/menuPanelContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp">

        <ScrollView
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_menu_card"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ตั้งค่า PS Translator"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <ImageButton
                        android:id="@+id/btnCloseMenu"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_close"
                        app:tint="#FFFFFF"
                        android:contentDescription="ปิดเมนู"/>
                </LinearLayout>

                <!-- Subtitle Toggle -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/subOverlaySwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="แสดงกล่องซับไตเติ้ลบนจอ"
                    android:textColor="#EEEEEE"
                    android:textSize="15sp"
                    android:checked="true"
                    android:layout_marginBottom="8dp"/>

                <!-- TTS Voice Toggle -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/ttsVoiceSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="อ่านออกเสียงพากย์ไทย (TTS)"
                    android:textColor="#EEEEEE"
                    android:textSize="15sp"
                    android:checked="false"
                    android:layout_marginBottom="8dp"/>

                <!-- Voice Gender Mode Selection (visible when TTS is enabled) -->
                <LinearLayout
                    android:id="@+id/voiceGenderContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="น้ำเสียงพากย์ (วิเคราะห์เพศ):"
                        android:textColor="#AAAAAA"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp"/>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/voiceGenderToggleGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:checkedButton="@id/btnVoiceAuto">

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:id="@+id/btnVoiceAuto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="AI อัตโนมัติ"
                            android:textSize="12sp"
                            android:textColor="#FFFFFF"
                            app:strokeColor="#55FFFFFF"/>

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:id="@+id/btnVoiceFemale"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="หญิง"
                            android:textSize="12sp"
                            android:textColor="#FFFFFF"
                            app:strokeColor="#55FFFFFF"/>

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:id="@+id/btnVoiceMale"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ชาย"
                            android:textSize="12sp"
                            android:textColor="#FFFFFF"
                            app:strokeColor="#55FFFFFF"/>
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

                <!-- Speech Speed Selection (visible when TTS is enabled) -->
                <LinearLayout
                    android:id="@+id/speechSpeedContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ความเร็วเสียงพูด:"
                        android:textColor="#AAAAAA"
                        android:textSize="13sp"
                        android:layout_marginBottom="6dp"/>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/speechSpeedToggleGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:checkedButton="@id/btnSpeedFast">

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:id="@+id/btnSpeedNormal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1.0x"
                            android:textSize="12sp"
                            android:textColor="#FFFFFF"
                            app:strokeColor="#55FFFFFF"/>

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:id="@+id/btnSpeedFast"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="1.25x (แนะนำ)"
                            android:textSize="12sp"
                            android:textColor="#FFFFFF"
                            app:strokeColor="#55FFFFFF"/>

                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:id="@+id/btnSpeedVeryFast"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1.5x"
                            android:textSize="12sp"
                            android:textColor="#FFFFFF"
                            app:strokeColor="#55FFFFFF"/>
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

                <!-- Filter short UI text toggle -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/filterShortTextSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="กรองปุ่ม UI สั้นๆ ออก (ให้อ่านเฉพาะบทพูด)"
                    android:textColor="#EEEEEE"
                    android:textSize="15sp"
                    android:checked="true"
                    android:layout_marginBottom="16dp"/>

                <!-- Adjust Subtitle Crop Box Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdjustCropBox"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ปรับกรอบพื้นที่ตรวจจับซับไตเติ้ล"
                    android:textColor="#FFFFFF"
                    app:icon="@drawable/ic_crop_free"
                    app:iconTint="#00E676"
                    app:strokeColor="#00E676"
                    android:layout_marginBottom="10dp"/>

                <!-- Mute Phone Audio Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMuteAudio"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ปิดเสียงเกมจากมือถือ"
                    android:textColor="#FFFFFF"
                    app:icon="@drawable/ic_volume_up"
                    app:iconTint="#FFFFFF"
                    app:strokeColor="#55FFFFFF"
                    android:layout_marginBottom="10dp"/>

                <!-- Text-Only Mode Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTextOnlyMode"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="โหมดโชว์เฉพาะตัวหนังสือ (จอดำ)"
                    android:textColor="#FFFFFF"
                    app:strokeColor="#55FFFFFF"
                    android:layout_marginBottom="16dp"/>

                <!-- Display Mode Aspect Ratio -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="อัตราส่วนภาพเกม:"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/displayModeToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:checkedButton="@id/display_mode_normal_button"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:id="@+id/display_mode_normal_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ปกติ"
                        android:textColor="#FFFFFF"
                        app:strokeColor="#55FFFFFF"/>
                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:id="@+id/display_mode_zoom_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ซูม"
                        android:textColor="#FFFFFF"
                        app:strokeColor="#55FFFFFF"/>
                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:id="@+id/display_mode_stretch_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="เต็มจอ"
                        android:textColor="#FFFFFF"
                        app:strokeColor="#55FFFFFF"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</FrameLayout>