<Window x:Class="PSTranslatorWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PS Translator v2.0.8 - สำหรับ Windows 11"
        Width="440" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#121418"
        Foreground="White"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E2229"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#252A34"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <!-- Header -->
            <TextBlock Text="PS Translator v2.0.8 (Windows 11)"
                       FontSize="20" FontWeight="Bold" Foreground="#00E676"
                       Margin="0,0,0,4"/>
            <TextBlock Text="ระบบแปลซับไตเติ้ลเกมแบบเรียลไทม์ + พากย์เสียงภาษาไทยอัตโนมัติ"
                       FontSize="12" Foreground="#B0BEC5"
                       Margin="0,0,0,14"/>

            <!-- Start / Stop & Crop Box Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Button x:Name="BtnToggleCapture"
                            Style="{StaticResource ActionBtnStyle}"
                            Content="เริ่มระบบแปลภาษาอัตโนมัติ (กำลังทำงาน)"
                            Background="#2E7D32" BorderBrush="#00E676"
                            FontSize="14" Margin="0,0,0,10"
                            Click="BtnToggleCapture_Click"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnShowCropBox"
                                Grid.Column="0"
                                Style="{StaticResource ActionBtnStyle}"
                                Content="ปรับกรอบพื้นที่อ่านซับไตเติ้ล"
                                BorderBrush="#00E676" Foreground="#00E676"
                                Click="BtnShowCropBox_Click"/>
                        <Button x:Name="BtnResetCropBox"
                                Grid.Column="2"
                                Style="{StaticResource ActionBtnStyle}"
                                Content="รีเซ็ตกรอบ"
                                Click="BtnResetCropBox_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Display & Subtitle Settings -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <CheckBox x:Name="ChkShowOverlay"
                              Content="แสดงกล่องซับไตเติ้ลแปลภาษาบนหน้าจอ"
                              Foreground="White" FontSize="14" FontWeight="Bold"
                              IsChecked="True" Margin="0,0,0,10"
                              Checked="ChkShowOverlay_Changed" Unchecked="ChkShowOverlay_Changed"/>

                    <CheckBox x:Name="ChkFilterShort"
                              Content="กรองปุ่ม UI สั้นๆ ออก (อ่านเฉพาะบทสนทนา)"
                              Foreground="White" FontSize="13"
                              IsChecked="True" Margin="0,0,0,12"
                              Checked="ChkFilterShort_Changed" Unchecked="ChkFilterShort_Changed"/>

                    <Button x:Name="BtnBlackScreenMode"
                            Style="{StaticResource ActionBtnStyle}"
                            Content="โหมดโชว์เฉพาะตัวหนังสือ (จอดำเต็มจอ)"
                            Click="BtnBlackScreenMode_Click"/>
                </StackPanel>
            </Border>

            <!-- TTS Voice & Speed Settings -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <CheckBox x:Name="ChkTtsEnabled"
                              Content="อ่านออกเสียงพากย์ไทยอัตโนมัติ (TTS)"
                              Foreground="White" FontSize="14" FontWeight="Bold"
                              IsChecked="True" Margin="0,0,0,12"
                              Checked="ChkTtsEnabled_Changed" Unchecked="ChkTtsEnabled_Changed"/>

                    <TextBlock Text="น้ำเสียงพากย์ (เลือกเพศเสียง):"
                               Foreground="#B0BEC5" FontSize="12" Margin="0,0,0,6"/>
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <Button x:Name="BtnVoiceAuto"
                                Style="{StaticResource ActionBtnStyle}"
                                Content="AI อัตโนมัติ" Margin="0,0,4,0"
                                Click="BtnVoiceAuto_Click"/>
                        <Button x:Name="BtnVoiceFemale"
                                Style="{StaticResource ActionBtnStyle}"
                                Content="หญิง" Margin="2,0,2,0"
                                Click="BtnVoiceFemale_Click"/>
                        <Button x:Name="BtnVoiceMale"
                                Style="{StaticResource ActionBtnStyle}"
                                Content="ชาย" Margin="4,0,0,0"
                                Click="BtnVoiceMale_Click"/>
                    </UniformGrid>

                    <TextBlock Text="ความเร็วเสียงพูด:"
                               Foreground="#B0BEC5" FontSize="12" Margin="0,0,0,6"/>
                    <UniformGrid Columns="3">
                        <Button x:Name="BtnSpeedNormal"
                                Style="{StaticResource ActionBtnStyle}"
                                Content="1.0x" Margin="0,0,4,0"
                                Click="BtnSpeedNormal_Click"/>
                        <Button x:Name="BtnSpeedFast"
                                Style="{StaticResource ActionBtnStyle}"
                                Content="1.25x (แนะนำ)" Margin="2,0,2,0"
                                Click="BtnSpeedFast_Click"/>
                        <Button x:Name="BtnSpeedVeryFast"
                                Style="{StaticResource ActionBtnStyle}"
                                Content="1.5x" Margin="4,0,0,0"
                                Click="BtnSpeedVeryFast_Click"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Chiaki PS5 Remote Play Helper & PSN ID Memory -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="ตั้งค่าเชื่อมต่อ PS5 Remote Play &amp; จำค่า PSN ID"
                               FontWeight="Bold" Foreground="#00E676" FontSize="13"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="PSN Account ID (Base64 - บันทึกอัตโนมัติ):"
                               Foreground="#B0BEC5" FontSize="12" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtPsnId"
                                 Grid.Column="0"
                                 Background="#121418" Foreground="White"
                                 BorderBrush="#44FFFFFF" Padding="8,6"
                                 FontSize="13" VerticalContentAlignment="Center"
                                 TextChanged="TxtPsnId_TextChanged"/>
                        <Button Grid.Column="2"
                                Style="{StaticResource ActionBtnStyle}"
                                Content="คัดลอก"
                                Click="BtnCopyPsnId_Click"/>
                    </Grid>

                    <Button x:Name="BtnLaunchChiaki"
                            Style="{StaticResource ActionBtnStyle}"
                            Content="เปิดโปรแกรมสตรีม PS5 (Chiaki สำหรับ Windows)"
                            Background="#1565C0" BorderBrush="#42A5F5"
                            Click="BtnLaunchChiaki_Click"/>
                </StackPanel>
            </Border>

            <!-- Live Status Preview -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="สถานะการตรวจจับล่าสุด:"
                               Foreground="#B0BEC5" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtStatusPreview"
                               Text="กำลังรอตรวจจับซับไตเติ้ลในกรอบ..."
                               Foreground="#FFEA00" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
