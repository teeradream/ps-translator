<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainStreamLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".stream.StreamActivity"
    android:keepScreenOn="true"
    android:background="#000000">

    <!-- Game Video Stream -->
    <com.metallic.chiaki.stream.AspectRatioFrameLayout
        android:id="@+id/aspectRatioLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">
        <SurfaceView
            android:id="@+id/surfaceView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </com.metallic.chiaki.stream.AspectRatioFrameLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"/>

    <!-- Subtitle Translation Overlay (floating over video stream) -->
    <LinearLayout
        android:id="@+id/subtitleOverlayContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#D9060810"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="false">

        <TextView
            android:id="@+id/originalSubText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:text=""
            android:visibility="gone"/>

        <TextView
            android:id="@+id/translatedSubText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:shadowColor="#FF000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:gravity="center"
            android:text=""/>
    </LinearLayout>

    <!-- Pure Text Only Mode: ONLY text on pure black background without video -->
    <FrameLayout
        android:id="@+id/pureFullscreenLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="28dp">

            <TextView
                android:id="@+id/pureOriginalText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#77FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginBottom="12dp"
                android:text=""
                android:visibility="gone"/>

            <TextView
                android:id="@+id/pureFullscreenText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center"
                android:text="PS Translator\n(รอรับข้อความซับไตเติ้ลจากเกม...)"/>

            <TextView
                android:id="@+id/pureFullscreenHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#55FFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="24dp"
                android:text="(แตะที่หน้าจอเพื่อสลับกลับสู่โหมดภาพเกม)"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Floating Circular Button with 3 lines (Hamburger Menu) -->
    <ImageButton
        android:id="@+id/btnMenuToggle"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_circle_button"
        android:src="@drawable/ic_menu_3lines"
        android:contentDescription="ตั้งค่าการแปลภาษา"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Settings Menu Modal Backdrop & Panel -->
    <FrameLayout
        android:id="@+id/menuPanelContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp">

        <ScrollView
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_menu_card"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ตั้งค่า PS Translator"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <ImageButton
                        android:id="@+id/btnCloseMenu"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_close"
                        app:tint="#FFFFFF"
                        android:contentDescription="ปิดเมนู"/>
                </LinearLayout>

                <!-- Subtitle Toggle -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/subOverlaySwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="แสดงกล่องซับไตเติ้ลบนจอ"
                    android:textColor="#EEEEEE"
                    android:textSize="15sp"
                    android:checked="true"
                    android:layout_marginBottom="8dp"/>

                <!-- TTS Voice Toggle -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/ttsVoiceSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="อ่านออกเสียงพากย์ไทย (TTS)"
                    android:textColor="#EEEEEE"
                    android:textSize="15sp"
                    android:checked="false"
                    android:layout_marginBottom="16dp"/>

                <!-- Mute Phone Audio Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMuteAudio"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ปิดเสียงเกมจากมือถือ"
                    android:textColor="#FFFFFF"
                    app:icon="@drawable/ic_volume_up"
                    app:iconTint="#FFFFFF"
                    app:strokeColor="#55FFFFFF"
                    android:layout_marginBottom="10dp"/>

                <!-- Text-Only Mode Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTextOnlyMode"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="โหมดโชว์เฉพาะตัวหนังสือ (จอดำ)"
                    android:textColor="#FFFFFF"
                    app:strokeColor="#55FFFFFF"
                    android:layout_marginBottom="16dp"/>

                <!-- Display Mode Aspect Ratio -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="อัตราส่วนภาพเกม:"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/displayModeToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:checkedButton="@id/display_mode_normal_button"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:id="@+id/display_mode_normal_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ปกติ"
                        android:textColor="#FFFFFF"
                        app:strokeColor="#55FFFFFF"/>
                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:id="@+id/display_mode_zoom_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ซูม"
                        android:textColor="#FFFFFF"
                        app:strokeColor="#55FFFFFF"/>
                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:id="@+id/display_mode_stretch_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="เต็มจอ"
                        android:textColor="#FFFFFF"
                        app:strokeColor="#55FFFFFF"/>
                </com.google.android.material.button.MaterialButtonToggleGroup>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</FrameLayout>