<Window x:Class="PSTranslatorWin.SubtitleOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PS Translator Subtitle Overlay"
        Width="960" Height="160"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">
    <Grid>
        <Border x:Name="OverlayBorder"
                Background="#D8080808"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24,14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MouseLeftButtonDown="OverlayBorder_MouseLeftButtonDown">
            <StackPanel>
                <TextBlock x:Name="OriginalText"
                           Text=""
                           Foreground="#B0BEC5"
                           FontSize="16"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"/>
                <TextBlock x:Name="TranslatedText"
                           Text="พร้อมแปลซับไตเติ้ลอัตโนมัติ..."
                           Foreground="#FFEA00"
                           FontSize="26"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
