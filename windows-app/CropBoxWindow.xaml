<Window x:Class="PSTranslatorWin.CropBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="กรอบตรวจจับซับไตเติ้ล PS Translator"
        Width="780" Height="160"
        MinWidth="260" MinHeight="70"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#05000000"
        Topmost="True"
        ShowInTaskbar="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="10"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#00E676" BorderThickness="3" CornerRadius="6" Background="#1400E676"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="#DD111111" CornerRadius="0,0,6,0" Padding="10,4">
                <TextBlock Text="กรอบอ่านซับไตเติ้ล (คลิกค้างเพื่อลากย้าย / ลากขอบมุมเพื่อปรับขนาด)"
                           Foreground="#00E676" FontSize="12" FontWeight="Bold"/>
            </Border>

            <Button Content="บันทึกและซ่อนกรอบ"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="6" Padding="10,4"
                    Background="#2E7D32" Foreground="White" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnSave_Click"/>
        </Grid>
    </Border>
</Window>
