<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FFFF4FA3"
                android:endColor="#FFFF9A4A" />
            <corners android:radius="999dp" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FFD93D89"
                android:endColor="#FFD97F38" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3322113B" />
            <corners android:radius="999dp" />
            <stroke
                android:width="1.5dp"
                android:color="#CCFF5AA5" />
        </shape>
    </item>
</selector>
