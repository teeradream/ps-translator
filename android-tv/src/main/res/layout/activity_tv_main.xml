<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0818">

    <!-- Layer 1: In-App Hardware HDMI Passthrough (for TVs supporting TvView TIF) -->
    <android.media.tv.TvView
        android:id="@+id/tvHdmiView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Layer 2: Transparent Live Subtitle Overlay WebView (loads http://<phone-ip>:8791/tv) -->
    <WebView
        android:id="@+id/overlayWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!-- Layer 3: Vice City Bottom Control Dock (D-Pad friendly, auto-hideable with OK/Back) -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:background="@drawable/bg_vice_card"
        android:gravity="center_horizontal"
        android:minWidth="620dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="22dp"
        android:paddingEnd="28dp"
        android:paddingBottom="22dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="12dp"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="PS TRANSLATOR ANDROID TV"
                android:textColor="#FF7BBF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Status Line -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/dot_status" />

            <TextView
                android:id="@+id/tvStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="กำลังค้นหามือถือ PS Translator ใน Wi-Fi บ้าน..."
                android:textColor="#F6EAFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Action Buttons Row (TV Remote D-Pad Focusable) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFloatingOverlay"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_vice_btn"
                android:focusable="true"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="✨ ลอยทับ HDMI: ปิด"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSelectHdmi"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_vice_btn"
                android:focusable="true"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="📺 ช่อง HDMI: อัตโนมัติ"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnManualIp"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_vice_btn"
                android:focusable="true"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="⌨️ ใส่ IP เอง"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_vice_btn"
                android:focusable="true"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="🔌 ตัดการเชื่อมต่อ"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCheckUpdate"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:background="@drawable/bg_vice_btn"
                android:focusable="true"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="🔄 อัปเดตแอป"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="กดปุ่ม BACK เพื่อซ่อนแถบเมนู  •  เปิดโหมด 'ลอยทับ HDMI' แล้วสลับช่องรีโมตไป PS5 ได้เลย"
            android:textColor="#C9A8E8"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
